<?xml version="1.0" encoding="utf-8"?>
<!-- Scholar brand background layer for the Android adaptive icon: the same
     blue -> indigo -> cyan gradient used for the in-app logo tile
     (AppShell.tsx: linear-gradient(135deg, #2563eb, #4f46e5 60%, #0891b2)). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#2563EB"
                android:centerColor="#4F46E5"
                android:endColor="#0891B2" />
        </aapt:attr>
    </path>
</vector>
